{
  "name": "arcana-vtt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Edge Serverless do ArcanaVTT em Hono.js + TypeScript + Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply arcana_vtt_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply arcana_vtt_db --remote"
  },
  "dependencies": {
    "hono": "^4.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.162.0"
  }
}
